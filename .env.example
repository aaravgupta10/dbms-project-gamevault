PORT=5000
NODE_ENV=development

# Multi-document transactions and change streams require a replica set.
# Easiest option: a free MongoDB Atlas cluster (already a replica set).
# Local alternative: run `mongod --replSet rs0 --dbpath <path>` then, once,
# connect with the mongo shell and run `rs.initiate()`.
MONGO_URI=mongodb://127.0.0.1:27017/gamevault?replicaSet=rs0
